# ============================================================
# asian.directory Backend Environment Variables
# ============================================================
# Copy this file to .env for local development.
# On Railway, set these as service variables.
# ============================================================

# Server
PORT=3000
NODE_ENV=production

# JWT Secret (REQUIRED — generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# CSRF Secret
CSRF_SECRET=change-me-to-another-random-string

# ============================================================
# Database
# ============================================================
# Railway PostgreSQL: automatically set by the Railway PostgreSQL plugin.
# When DATABASE_URL is set, the server uses PostgreSQL.
# When DATABASE_URL is NOT set, it falls back to local SQLite.
DATABASE_URL=postgresql://user:password@host:5432/railway

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=https://asian.directory,https://www.asian.directory,https://asiandirectory-production-7ec4.up.railway.app

# ============================================================
# OAuth (optional — leave blank to disable)
# ============================================================
# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://asiandirectory-production-7ec4.up.railway.app/api/auth/google/callback

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://asiandirectory-production-7ec4.up.railway.app/api/auth/facebook/callback

# Comma-separated emails allowed to become admins via social login (the provider
# must report the address as verified). When this is set it is the only way in:
# everyone else signs in as a read-only viewer. When it is empty, the first
# account on a site with no admin is promoted instead — on a public site that is
# whoever clicks first. See SOCIAL_LOGIN_SETUP.md for the full walkthrough.
ADMIN_EMAILS=

# ============================================================
# Homepage chat (optional)
# ============================================================
# Public POST /api/chat uses the existing search planner, then Grok if a key is set.
# Set XAI_API_KEY on Railway. GROK_API_KEY is accepted as an alias.
# Model defaults to grok-4.3 (current cheap chat id on docs.x.ai, 2026-08).
XAI_API_KEY=
# GROK_API_KEY=
# XAI_MODEL=grok-4.3
